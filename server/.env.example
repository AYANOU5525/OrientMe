# Clé API Google AI Studio : https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Modèle principal, servi par l'API Gemini (Gemma 4 : gemma-4-26b-a4b-it ou gemma-4-31b-it)
GEMINI_MODEL=gemma-4-26b-a4b-it

# Modèles de secours essayés dans l'ordre si le principal échoue (quota, surcharge, réponse invalide).
# Séparés par des virgules ; laisser vide pour désactiver.
GEMINI_FALLBACK_MODELS=gemma-4-31b-it

# Budget total d'une analyse en millisecondes (tous modèles et tentatives confondus)
GEMINI_TIMEOUT_MS=60000

# Optionnel : niveau de réflexion du modèle (minimal ou high pour Gemma 4)
# GEMINI_THINKING_LEVEL=minimal

PORT=3001

# Optionnel : origines autorisées par CORS, séparées par des virgules
# CORS_ORIGINS=http://localhost:5173
