# Clé API Google AI Studio : https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Modèle principal, servi par l'API Gemini. Seuls les modèles Gemma sont acceptés
# (Gemma 4 : gemma-4-26b-a4b-it ou gemma-4-31b-it)
GEMINI_MODEL=gemma-4-26b-a4b-it

# Modèles Gemma de secours essayés dans l'ordre si le principal échoue (quota, surcharge, réponse invalide).
# Séparés par des virgules ; laisser vide pour désactiver.
GEMINI_FALLBACK_MODELS=gemma-4-31b-it

# Budget total d'une analyse en millisecondes (tous modèles et tentatives confondus)
GEMINI_TIMEOUT_MS=60000

# Optionnel : niveau de réflexion du modèle (minimal par défaut, ou high).
# Avec high, Gemma 4 met 45 à 110 s au lieu de ~20 s et peut dépasser GEMINI_TIMEOUT_MS.
# GEMINI_THINKING_LEVEL=minimal

PORT=3001

# Optionnel : origines autorisées par CORS, séparées par des virgules
# CORS_ORIGINS=http://localhost:5173

# Optionnel : mot de passe de l'espace conseillers (…/#conseillers). Vide = espace désactivé
# ADMIN_TOKEN=choisis-un-mot-de-passe-long

# Optionnel : mettre 1 derrière un hébergeur (Render, Railway…) pour lire la vraie IP des visiteurs
# TRUST_PROXY=1

# Optionnel : fichier des statistiques anonymes (par défaut server/data/stats.jsonl)
# STATS_FILE=
